# Build artifacts (recreated by ./pack.sh)
xc_vm.tar.gz
XC_VM.zip

# Per-install secrets & state — generated by the installer / the panel.
# Never commit real values; see xc_vm/config/config.example.ini.
xc_vm/config/config.ini
xc_vm/config/config.enc
xc_vm/config/install_id
xc_vm/config/signals.last
xc_vm/config/sysctl.on

# Panel-generated per-install nginx state (admin access-code vhosts).
# The two stock templates must stay — the installer renders them per install.
xc_vm/bin/nginx/conf/codes/*
!xc_vm/bin/nginx/conf/codes/template
!xc_vm/bin/nginx/conf/codes/template_ministra

# Media / library content from the source host is deliberately NOT tracked.
# pack.sh recreates the empty directory skeleton the panel expects.
xc_vm/content/
xc_vm/storage/images/*
!xc_vm/storage/images/index.html
!xc_vm/storage/images/admin/
!xc_vm/storage/images/admin/index.html
!xc_vm/storage/images/enigma2/
!xc_vm/storage/images/enigma2/index.html

# Runtime data / caches / logs
xc_vm/tmp/
xc_vm/backups/
xc_vm/bin/redis/redis-server.log
xc_vm/bin/redis/redis-server.pid
xc_vm/bin/redis/dump.rdb
xc_vm/bin/nginx/logs/*
!xc_vm/bin/nginx/logs/.gitkeep
xc_vm/bin/nginx_rtmp/logs/*
!xc_vm/bin/nginx_rtmp/logs/.gitkeep
xc_vm/bin/php/sockets/*
!xc_vm/bin/php/sockets/.gitkeep
xc_vm/bin/php/var/log/*
!xc_vm/bin/php/var/log/.gitkeep
xc_vm/bin/php/var/run/*
!xc_vm/bin/php/var/run/.gitkeep
**/__pycache__/
*.pyc
*.log

# Editor / panel .bak leftovers
*.bak
*.bak.*
*.bak.x

# OS noise
.DS_Store
